# คัดลอกเป็น .env.local / .env.staging ตามต้องการ (ไฟล์ *.local ไม่ถูก commit)
# LIFF ID จาก LINE Developers Console (ใช้ตอนเปิด liff.init ใน main.tsx)
VITE_LIFF_ID=

# เปิดเครื่องมือทดสอบใน build ที่ไม่ใช่ production เช่น `npm run build -- --mode staging`
# (production เปิดไม่ได้ ถึงตั้งเป็น true ก็ไม่มีผล)
VITE_DEV_TOOLS=false
